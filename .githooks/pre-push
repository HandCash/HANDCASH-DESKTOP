#!/usr/bin/env bash
# Refuse push to master unless package.json semver > latest remote tag.
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
remote_name="${1:-}"
url="${2:-}"

while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/master|refs/heads/main)
      node "$ROOT/scripts/require-version-bump.mjs"
      ;;
  esac
done

exit 0
