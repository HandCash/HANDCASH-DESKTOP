#!/usr/bin/env bash
# Refuse push to master unless package.json semver > latest remote tag.
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
remote_name="${1:-}"
url="${2:-}"

while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/master|refs/heads/main)
      node "$ROOT/scripts/require-version-bump.mjs"
      node "$ROOT/scripts/require-toolbox-patch.mjs"
      # The APK bundles without a typecheck; CI's release-* jobs run tsc and
      # fail after the phone already has the build. Catch it before either.
      (cd "$ROOT" && npx tsc -p tsconfig.json --noEmit)
      ;;
    # A tag push is what actually builds installers, and a stale toolbox patch
    # breaks `npm ci` in every release workflow.
    refs/tags/v*)
      node "$ROOT/scripts/require-toolbox-patch.mjs"
      ;;
  esac
done

exit 0
