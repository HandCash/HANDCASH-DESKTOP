{
  "version": 1,
  "updated": "2026-10-22",
  "about": "Handles nobody can buy or be issued unless the reservation's owner releases them. Names match case-insensitively after look-alike characters and separators are normalized (reservedHandles.ts); brand, product, person, coin and HandCash names also match with the affixes below. An entry's owner, else BRC-CLOUD's HANDLE_RESERVATION_OWNER_KEY, is the only identity that can release it. Bump version on every change, then run npm run sync:reserved-handles in BRC-CLOUD.",
  "affixes": ["official", "real", "the", "team", "support", "help", "hq", "app", "wallet", "pay", "admin", "verified", "inc", "care", "service", "staff", "store", "shop", "ceo", "bot", "login", "security", "account", "news", "global"],
  "patterns": [
    { "id": "versioned-alias-prefix", "match": "regex", "value": "^vv[0-9]{2}", "reason": "vvNN alias prefix handcash-cloud keeps for versioned aliases", "source": "handcash-cloud src/domain/aliasNormalizer.js" },
    { "id": "guest-prefix", "match": "prefix", "value": "guest0", "reason": "Guest account aliases (guest0…), never permanent handles", "source": "handcash-cloud src/domain/aliasNormalizer.js; items-market /api/handles/claim-ticket" },
    { "id": "business-wallet-prefix", "match": "prefix", "value": "bw0", "reason": "Business wallet aliases (bw0…)", "source": "handcash-cloud src/domain/aliasNormalizer.js" },
    { "id": "bitcoin-address", "match": "regex", "value": "^[13][1-9a-z]{25,34}$", "reason": "Looks like a Bitcoin address, which cannot be a handle", "source": "handcash-cloud src/domain/aliasNormalizer.js" },
    { "id": "account-id", "match": "regex", "value": "^[0-9a-f]{24}$", "reason": "Looks like a HandCash account id, which cannot be a handle", "source": "handcash-cloud src/domain/aliasNormalizer.js" }
  ],
