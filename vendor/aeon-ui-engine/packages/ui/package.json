{
  "name": "@aeon-ui/ui",
  "version": "0.1.0",
  "description": "Styled Aeon UI components (Panda CSS recipes)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/GenericCPU/aeon-ui.git",
    "directory": "packages/ui"
  },
  "publishConfig": { "access": "public" },
  "files": ["dist", "src/styles.css", "README.md"],
  "keywords": ["aeon-ui", "react", "components", "design-system"],
  "type": "module",
  "sideEffects": ["**/*.css"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": {
      "default": "./src/styles.css"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --external react --external react-dom --external @aeon-ui/panda/styled-system/css --external @aeon-ui/panda/styled-system/recipes",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aeon-ui/panda": "workspace:*",
    "@aeon-ui/react": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "devDependencies": {
    "@types/react": "^19.1.2",
    "react": "^19.1.0",
    "tsup": "^8.4.0",
    "typescript": "^5.8.3"
  }
}
