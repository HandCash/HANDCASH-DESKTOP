{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aeon-ui.com/schemas/accordion.json",
  "title": "Accordion",
  "description": "Per-item open state via accordionMachine.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "component",
    "scope"
  ],
  "properties": {
    "component": {
      "const": "Accordion"
    },
    "scope": {
      "const": "accordion"
    },
    "parts": {
      "type": "array",
      "description": "Anatomy part keys — map to data-aeon-part",
      "items": {
        "type": "string",
        "enum": [
          "root",
          "item",
          "itemTrigger",
          "itemContent",
          "itemIndicator"
        ]
      },
      "uniqueItems": true
    },
    "states": {
      "type": "array",
      "description": "Allowed data-aeon-state values (stable states only)",
      "items": {
        "type": "string",
        "enum": [
          "open",
          "closed"
        ]
      },
      "uniqueItems": true
    },
    "props": {
      "type": "object",
      "additionalProperties": false,
      "properties": {}
    },
    "slots": {
      "type": "object",
      "description": "Named composition slots / compound parts",
      "additionalProperties": {
        "type": "string"
      },
      "properties": {
        "Root": {
          "const": "accordion.root",
          "description": "accordion.root"
        },
        "Item": {
          "const": "accordion.item",
          "description": "accordion.item"
        },
        "ItemTrigger": {
          "const": "accordion.itemTrigger",
          "description": "accordion.itemTrigger"
        },
        "ItemContent": {
          "const": "accordion.itemContent",
          "description": "accordion.itemContent"
        }
      }
    },
    "machine": {
      "type": [
        "string",
        "null"
      ],
      "description": "XState machine export from @aeon-ui/primitives, or null if prop/React driven",
      "const": "accordionMachine"
    },
    "runtime": {
      "type": "string",
      "description": "How headless state is driven at runtime",
      "const": "useAeonMachine"
    },
    "events": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "TOGGLE"
        ]
      }
    },
    "examples": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    }
  },
  "x-aeon": {
    "scope": "accordion",
    "parts": [
      "root",
      "item",
      "itemTrigger",
      "itemContent",
      "itemIndicator"
    ],
    "states": [
      "open",
      "closed"
    ],
    "machine": "accordionMachine",
    "runtime": "useAeonMachine",
    "events": [
      "TOGGLE"
    ],
    "slots": {
      "Root": "accordion.root",
      "Item": "accordion.item",
      "ItemTrigger": "accordion.itemTrigger",
      "ItemContent": "accordion.itemContent"
    },
    "examples": []
  }
}
