{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aeon-ui.com/schemas/thread.json",
  "title": "Thread",
  "description": "Message stream — item state prop mine | theirs | pending | failed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "component",
    "scope"
  ],
  "properties": {
    "component": {
      "const": "Thread"
    },
    "scope": {
      "const": "thread"
    },
    "parts": {
      "type": "array",
      "description": "Anatomy part keys — map to data-aeon-part",
      "items": {
        "type": "string",
        "enum": [
          "root",
          "list",
          "item",
          "bubble",
          "meta",
          "day"
        ]
      },
      "uniqueItems": true
    },
    "states": {
      "type": "array",
      "description": "Allowed data-aeon-state values (stable states only)",
      "items": {
        "type": "string",
        "enum": [
          "mine",
          "theirs",
          "pending",
          "failed"
        ]
      },
      "uniqueItems": true
    },
    "props": {
      "type": "object",
      "additionalProperties": false,
      "properties": {}
    },
    "slots": {
      "type": "object",
      "description": "Named composition slots / compound parts",
      "additionalProperties": {
        "type": "string"
      },
      "properties": {
        "Root": {
          "const": "thread.root",
          "description": "thread.root"
        },
        "Item": {
          "const": "thread.item",
          "description": "thread.item"
        },
        "Bubble": {
          "const": "thread.bubble",
          "description": "thread.bubble"
        }
      }
    },
    "machine": {
      "type": [
        "string",
        "null"
      ],
      "description": "XState machine export from @aeon-ui/primitives, or null if prop/React driven",
      "const": null
    },
    "runtime": {
      "type": "string",
      "description": "How headless state is driven at runtime",
      "const": "props"
    },
    "events": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": []
      }
    },
    "examples": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    }
  },
  "x-aeon": {
    "scope": "thread",
    "parts": [
      "root",
      "list",
      "item",
      "bubble",
      "meta",
      "day"
    ],
    "states": [
      "mine",
      "theirs",
      "pending",
      "failed"
    ],
    "machine": null,
    "runtime": "props",
    "events": [],
    "slots": {
      "Root": "thread.root",
      "Item": "thread.item",
      "Bubble": "thread.bubble"
    },
    "examples": []
  }
}
