{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aeon-ui.com/schemas/dialog.json",
  "title": "Dialog",
  "description": "Modal open/closed via dialogMachine. Dismissal is a transition, not ad hoc flags.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "component",
    "scope"
  ],
  "properties": {
    "component": {
      "const": "Dialog"
    },
    "scope": {
      "const": "dialog"
    },
    "parts": {
      "type": "array",
      "description": "Anatomy part keys — map to data-aeon-part",
      "items": {
        "type": "string",
        "enum": [
          "root",
          "trigger",
          "portal",
          "backdrop",
          "positioner",
          "content",
          "title",
          "description",
          "closeTrigger"
        ]
      },
      "uniqueItems": true
    },
    "states": {
      "type": "array",
      "description": "Allowed data-aeon-state values (stable states only)",
      "items": {
        "type": "string",
        "enum": [
          "open",
          "closed"
        ]
      },
      "uniqueItems": true
    },
    "props": {
      "type": "object",
      "additionalProperties": false,
      "properties": {}
    },
    "slots": {
      "type": "object",
      "description": "Named composition slots / compound parts",
      "additionalProperties": {
        "type": "string"
      },
      "properties": {
        "Root": {
          "const": "dialog.root",
          "description": "dialog.root"
        },
        "Trigger": {
          "const": "dialog.trigger",
          "description": "dialog.trigger"
        },
        "Content": {
          "const": "dialog.content",
          "description": "dialog.content"
        },
        "Title": {
          "const": "dialog.title",
          "description": "dialog.title"
        },
        "Description": {
          "const": "dialog.description",
          "description": "dialog.description"
        },
        "CloseTrigger": {
          "const": "dialog.closeTrigger",
          "description": "dialog.closeTrigger"
        }
      }
    },
    "machine": {
      "type": [
        "string",
        "null"
      ],
      "description": "XState machine export from @aeon-ui/primitives, or null if prop/React driven",
      "const": "dialogMachine"
    },
    "runtime": {
      "type": "string",
      "description": "How headless state is driven at runtime",
      "const": "useAeonMachine"
    },
    "events": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "OPEN",
          "CLOSE",
          "TOGGLE"
        ]
      }
    },
    "examples": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    }
  },
  "x-aeon": {
    "scope": "dialog",
    "parts": [
      "root",
      "trigger",
      "portal",
      "backdrop",
      "positioner",
      "content",
      "title",
      "description",
      "closeTrigger"
    ],
    "states": [
      "open",
      "closed"
    ],
    "machine": "dialogMachine",
    "runtime": "useAeonMachine",
    "events": [
      "OPEN",
      "CLOSE",
      "TOGGLE"
    ],
    "slots": {
      "Root": "dialog.root",
      "Trigger": "dialog.trigger",
      "Content": "dialog.content",
      "Title": "dialog.title",
      "Description": "dialog.description",
      "CloseTrigger": "dialog.closeTrigger"
    },
    "examples": []
  }
}
