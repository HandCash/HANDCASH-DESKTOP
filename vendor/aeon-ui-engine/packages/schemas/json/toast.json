{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aeon-ui.com/schemas/toast.json",
  "title": "Toast",
  "description": "Per-item visibility via toastMachine.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "component",
    "scope"
  ],
  "properties": {
    "component": {
      "const": "Toast"
    },
    "scope": {
      "const": "toast"
    },
    "parts": {
      "type": "array",
      "description": "Anatomy part keys — map to data-aeon-part",
      "items": {
        "type": "string",
        "enum": [
          "viewport",
          "root",
          "title",
          "description",
          "closeTrigger"
        ]
      },
      "uniqueItems": true
    },
    "states": {
      "type": "array",
      "description": "Allowed data-aeon-state values (stable states only)",
      "items": {
        "type": "string",
        "enum": [
          "visible",
          "hidden"
        ]
      },
      "uniqueItems": true
    },
    "props": {
      "type": "object",
      "additionalProperties": false,
      "properties": {}
    },
    "slots": {
      "type": "object",
      "description": "Named composition slots / compound parts",
      "additionalProperties": {
        "type": "string"
      },
      "properties": {
        "Provider": {
          "const": "toast.provider",
          "description": "toast.provider"
        },
        "Viewport": {
          "const": "toast.viewport",
          "description": "toast.viewport"
        },
        "Root": {
          "const": "toast.root",
          "description": "toast.root"
        },
        "Title": {
          "const": "toast.title",
          "description": "toast.title"
        },
        "Description": {
          "const": "toast.description",
          "description": "toast.description"
        }
      }
    },
    "machine": {
      "type": [
        "string",
        "null"
      ],
      "description": "XState machine export from @aeon-ui/primitives, or null if prop/React driven",
      "const": "toastMachine"
    },
    "runtime": {
      "type": "string",
      "description": "How headless state is driven at runtime",
      "const": "useAeonMachine"
    },
    "events": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "SHOW",
          "HIDE",
          "DISMISS"
        ]
      }
    },
    "examples": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    }
  },
  "x-aeon": {
    "scope": "toast",
    "parts": [
      "viewport",
      "root",
      "title",
      "description",
      "closeTrigger"
    ],
    "states": [
      "visible",
      "hidden"
    ],
    "machine": "toastMachine",
    "runtime": "useAeonMachine",
    "events": [
      "SHOW",
      "HIDE",
      "DISMISS"
    ],
    "slots": {
      "Provider": "toast.provider",
      "Viewport": "toast.viewport",
      "Root": "toast.root",
      "Title": "toast.title",
      "Description": "toast.description"
    },
    "examples": []
  }
}
