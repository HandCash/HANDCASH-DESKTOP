{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aeon-ui.com/schemas/listRow.json",
  "title": "ListRow",
  "description": "Settings / menu row — leading · label · trailing. Layout only.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "component",
    "scope"
  ],
  "properties": {
    "component": {
      "const": "ListRow"
    },
    "scope": {
      "const": "listRow"
    },
    "parts": {
      "type": "array",
      "description": "Anatomy part keys — map to data-aeon-part",
      "items": {
        "type": "string",
        "enum": [
          "root",
          "leading",
          "label",
          "description",
          "trailing"
        ]
      },
      "uniqueItems": true
    },
    "states": {
      "type": "array",
      "description": "Allowed data-aeon-state values (stable states only)",
      "items": {
        "type": "string",
        "enum": [
          "idle"
        ]
      },
      "uniqueItems": true
    },
    "props": {
      "type": "object",
      "additionalProperties": false,
      "properties": {}
    },
    "slots": {
      "type": "object",
      "description": "Named composition slots / compound parts",
      "additionalProperties": {
        "type": "string"
      },
      "properties": {
        "Root": {
          "const": "listRow.root",
          "description": "listRow.root"
        },
        "Leading": {
          "const": "listRow.leading",
          "description": "listRow.leading"
        },
        "Label": {
          "const": "listRow.label",
          "description": "listRow.label"
        },
        "Description": {
          "const": "listRow.description",
          "description": "listRow.description"
        },
        "Trailing": {
          "const": "listRow.trailing",
          "description": "listRow.trailing"
        }
      }
    },
    "machine": {
      "type": [
        "string",
        "null"
      ],
      "description": "XState machine export from @aeon-ui/primitives, or null if prop/React driven",
      "const": null
    },
    "runtime": {
      "type": "string",
      "description": "How headless state is driven at runtime",
      "const": "layout"
    },
    "events": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": []
      }
    },
    "examples": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    }
  },
  "x-aeon": {
    "scope": "listRow",
    "parts": [
      "root",
      "leading",
      "label",
      "description",
      "trailing"
    ],
    "states": [
      "idle"
    ],
    "machine": null,
    "runtime": "layout",
    "events": [],
    "slots": {
      "Root": "listRow.root",
      "Leading": "listRow.leading",
      "Label": "listRow.label",
      "Description": "listRow.description",
      "Trailing": "listRow.trailing"
    },
    "examples": []
  }
}
