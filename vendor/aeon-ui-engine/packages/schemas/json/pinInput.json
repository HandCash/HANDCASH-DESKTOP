{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aeon-ui.com/schemas/pinInput.json",
  "title": "PinInput",
  "description": "OTP / PIN cells — React state for digit buffer; projects idle | complete on root.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "component",
    "scope"
  ],
  "properties": {
    "component": {
      "const": "PinInput"
    },
    "scope": {
      "const": "pinInput"
    },
    "parts": {
      "type": "array",
      "description": "Anatomy part keys — map to data-aeon-part",
      "items": {
        "type": "string",
        "enum": [
          "root",
          "input"
        ]
      },
      "uniqueItems": true
    },
    "states": {
      "type": "array",
      "description": "Allowed data-aeon-state values (stable states only)",
      "items": {
        "type": "string",
        "enum": [
          "idle",
          "complete"
        ]
      },
      "uniqueItems": true
    },
    "props": {
      "type": "object",
      "additionalProperties": false,
      "properties": {}
    },
    "slots": {
      "type": "object",
      "description": "Named composition slots / compound parts",
      "additionalProperties": {
        "type": "string"
      },
      "properties": {
        "Root": {
          "const": "pinInput.root",
          "description": "pinInput.root"
        },
        "Input": {
          "const": "pinInput.input",
          "description": "pinInput.input"
        }
      }
    },
    "machine": {
      "type": [
        "string",
        "null"
      ],
      "description": "XState machine export from @aeon-ui/primitives, or null if prop/React driven",
      "const": null
    },
    "runtime": {
      "type": "string",
      "description": "How headless state is driven at runtime",
      "const": "useState"
    },
    "events": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": []
      }
    },
    "examples": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    }
  },
  "x-aeon": {
    "scope": "pinInput",
    "parts": [
      "root",
      "input"
    ],
    "states": [
      "idle",
      "complete"
    ],
    "machine": null,
    "runtime": "useState",
    "events": [],
    "slots": {
      "Root": "pinInput.root",
      "Input": "pinInput.input"
    },
    "examples": []
  }
}
