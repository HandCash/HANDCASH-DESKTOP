{
  "name": "@aeon-ui/scene",
  "version": "0.1.0",
  "description": "CSS 3D scene transforms and perspective helpers for Aeon Scene",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/GenericCPU/aeon-ui.git",
    "directory": "packages/scene"
  },
  "publishConfig": { "access": "public" },
  "files": ["dist", "README.md"],
  "keywords": ["aeon-ui", "scene", "3d", "css", "transform"],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "tsup": "^8.4.0",
    "typescript": "^5.8.3"
  }
}
