{
  "name": "@aeon-ui/core",
  "version": "0.1.0",
  "description": "Anatomy tokens, data-aeon attributes, and machine helpers for Aeon UI",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/GenericCPU/aeon-ui.git",
    "directory": "packages/core"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "theme-transition.css",
    "README.md"
  ],
  "keywords": [
    "aeon-ui",
    "statechart",
    "xstate",
    "headless",
    "anatomy"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./theme-transition.css": "./theme-transition.css"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "xstate": "^5.32.0"
  },
  "devDependencies": {
    "tsup": "^8.4.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.8"
  }
}
