{
  "name": "@aeon-ui/primitives",
  "version": "0.1.0",
  "description": "XState machines for Aeon UI primitives",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/GenericCPU/aeon-ui.git",
    "directory": "packages/primitives"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "aeon-ui",
    "xstate",
    "statechart",
    "machines"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./machines/*": {
      "types": "./dist/machines/*.d.ts",
      "import": "./dist/machines/*.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/machines/*.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@aeon-ui/core": "workspace:*",
    "xstate": "^5.32.0"
  },
  "devDependencies": {
    "tsup": "^8.4.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.8"
  }
}
