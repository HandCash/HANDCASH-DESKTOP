{
  "name": "@aeon-ui/svelte",
  "version": "0.1.0",
  "description": "Headless Svelte bindings for Aeon XState machines",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/GenericCPU/aeon-ui.git",
    "directory": "packages/svelte"
  },
  "private": true,
  "files": [
    "dist",
    "src/**/*.svelte",
    "README.md"
  ],
  "keywords": [
    "aeon-ui",
    "svelte",
    "headless",
    "xstate",
    "statechart"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "svelte": "./dist/index.js"
    },
    "./Switch.svelte": "./src/Switch.svelte",
    "./SwitchControl.svelte": "./src/SwitchControl.svelte",
    "./SwitchThumb.svelte": "./src/SwitchThumb.svelte",
    "./SwitchLabel.svelte": "./src/SwitchLabel.svelte",
    "./SwitchHiddenInput.svelte": "./src/SwitchHiddenInput.svelte"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --external svelte --external xstate --external @aeon-ui/core --external @aeon-ui/primitives",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aeon-ui/core": "workspace:*",
    "@aeon-ui/primitives": "workspace:*",
    "xstate": "^5.32.0"
  },
  "peerDependencies": {
    "svelte": "^4.0.0 || ^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "svelte": "^5.28.2",
    "svelte-check": "^4.1.5",
    "tsup": "^8.4.0",
    "typescript": "^5.8.3"
  }
}
