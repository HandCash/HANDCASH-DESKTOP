{
  "name": "aeon-ui-engine",
  "version": "1.3.9",
  "private": false,
  "type": "module",
  "bin": {
    "aeon-ui": "./packages/cli/dist/bin.js"
  },
  "exports": {
    "./vite": "./scripts/vite-aliases.mjs",
    "./aeon.css": "./packages/panda/aeon.css",
    "./tsconfig.base.json": "./tsconfig.base.json",
    "./CONSUMER.md": "./CONSUMER.md",
    "./schemas": "./packages/schemas/dist/index.js",
    "./schemas/catalog.json": "./packages/schemas/json/catalog.json"
  },
  "files": [
    "packages",
    "scripts",
    "tsconfig.base.json",
    "CONSUMER.md",
    "INTEGRATION.md",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "pnpm --filter @aeon-ui/panda run codegen && pnpm -r run build",
    "build:headless": "pnpm --filter @aeon-ui/core --filter @aeon-ui/primitives --filter @aeon-ui/react run build",
    "codegen": "pnpm --filter @aeon-ui/panda codegen",
    "dev": "pnpm --filter @aeon-ui/demo dev",
    "examples": "pnpm --filter @aeon-ui/examples dev",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm run test:headless",
    "test:headless": "pnpm run build:headless && pnpm --filter @aeon-ui/core --filter @aeon-ui/primitives --filter @aeon-ui/react run test",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish",
    "version:patch": "node scripts/bump-version.mjs patch",
    "version:minor": "node scripts/bump-version.mjs minor",
    "version:major": "node scripts/bump-version.mjs major",
    "version:push": "node scripts/bump-version.mjs patch --push",
    "version:check": "node scripts/require-version-bump.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.0",
    "typescript": "^5.8.3"
  },
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": ">=20"
  }
}
