{
  "name": "handcash-brc100",
  "version": "1.2.55",
  "description": "Official HandCash Desktop wallet (BETA) — self-custodial BRC-100, based on BSVA open standards",
  "main": "dist-electron/main.js",
  "type": "module",
  "author": "HandCash BRC100",
  "license": "Open BSV License",
  "homepage": "https://handcash.io",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:vite\" \"npm:dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on tcp:5173 && tsc -p tsconfig.electron.json && electron .",
    "build": "npm run build:renderer && npm run build:electron",
    "build:renderer": "tsc -p tsconfig.json --noEmit && vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "package": "npm run build && electron-builder",
    "package:linux": "npm run build && electron-builder --linux AppImage",
    "package:linux:all": "npm run build && electron-builder --linux AppImage deb",
    "package:mac": "npm run build && electron-builder --mac",
    "package:win": "npm run build && electron-builder --win",
    "preview": "vite preview",
    "postinstall": "patch-package",
    "test": "vitest run",
    "test:watch": "vitest",
    "launch": "bash scripts/launch.sh",
    "launch:mac": "bash scripts/launch-mac.sh",
    "version:patch": "node scripts/bump-version.mjs patch",
    "version:minor": "node scripts/bump-version.mjs minor",
    "version:major": "node scripts/bump-version.mjs major",
    "version:push": "node scripts/bump-version.mjs patch --push",
    "version:sync-market": "node scripts/bump-version.mjs --sync-market",
    "version:check": "node scripts/require-version-bump.mjs"
  },
  "dependencies": {
    "@bsv/sdk": "^2.2.0",
    "@bsv/wallet-toolbox-client": "2.4.4",
    "@xstate/react": "^5.0.3",
    "@zxing/browser": "^0.1.5",
    "aeon-ui-engine": "file:vendor/aeon-ui-engine",
    "cors": "^2.8.5",
    "electron-log": "^5.4.3",
    "electron-updater": "^6.7.3",
    "express": "^4.21.2",
    "mermaid": "^11.16.0",
    "node-forge": "^1.3.1",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "xstate": "^5.19.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.15.21",
    "@types/node-forge": "^1.3.11",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "electron": "^35.2.1",
    "electron-builder": "^26.0.12",
    "patch-package": "^8.0.1",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.7",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "io.handcash.brc100",
    "productName": "HandCash",
    "copyright": "Copyright © HandCash",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "afterPack": "scripts/afterPack.cjs",
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "HandCash",
        "repo": "HANDCASH-DESKTOP",
        "releaseType": "prerelease"
      }
    ],
    "mac": {
      "category": "public.app-category.finance",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}-mac.${ext}",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "writeUpdateInfo": true
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "HandCash",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Finance",
      "maintainer": "HandCash BRC100 <devs@handcash.io>",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "synopsis": "Official HandCash Desktop wallet",
      "description": "Official HandCash Desktop — self-custodial BRC-100 wallet with local app bridge.",
      "executableName": "HandCash"
    }
  }
}
